# Base de datos
# PostgreSQL (con docker compose up -d):
DATABASE_URL=postgresql+psycopg2://votaciones:votaciones@localhost:5432/votaciones
# Alternativa rápida con SQLite:
# DATABASE_URL=sqlite:///./votaciones.db

# JWT
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
